[init]
	defaultBranch = main
[push]
	default = simple
[pull]
	rebase = false
[core]
	pager = hunk pager
[alias]
	glog = log --graph --decorate --date=iso
	root = rev-parse --show-toplevel
[difftool]
	prompt = false
[difftool "hunk"]
	cmd = hunk difftool \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[diff]
	tool = hunk
[mergetool]
	prompt = false
[mergetool "codediff"]
	cmd = nvim \"$MERGED\" -c \"CodeDiff --exit-on-close merge \\\"$MERGED\\\"\"
[merge]
	tool = codediff
